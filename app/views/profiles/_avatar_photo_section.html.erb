<div class="avatar-container">
        <figure class="image">
            <%= render_avatar_image(user, variant: :profile, optional_class: "is-rounded")%>
        </figure>

    <% if user == current_user %>
        <%= link_to(image_tag("camera_icon.svg"), change_avatar_user_profile_path(current_user), class: "button is-rounded edit-btn-avatar") %>
    <% end %>
</div>
