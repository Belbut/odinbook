<div class="background-container">
    <figure class="image ">
        <%= image_tag user.profile.background.representation(resize_to_fill: [1250, 450]),class: "attachment", width: 1250, height: 450 %>
    </figure>

    <% if user == current_user %>
        <%= link_to("Edit Background", change_background_user_profile_path(current_user), class: "button is-rounded edit-btn-background") %>
    <% end %>
</div>
