<h2>Log in</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="field">
    <%= f.label :email %><br>
    <%= f.email_field :email, value: "crystal@odinbook.com", autofocus: true, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= f.label :password %><br>
    <%= f.password_field :password, value: "password123", autocomplete: "current-password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me %>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "Log in" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>

<div>
  <h2>Demo logins</h2>
  <p>You can test the social network by logging in with any of the following accounts to see it in action. Every account shares the same password.</p>

  <div><strong>Password (all accounts):</strong> password123</div>

  <% demo_accounts = [
       ["Chirpy Featherstone", "Bird",      "chirpy@odinbook.com"],
       ["Mocha Fields",        "Cow",       "mocha@odinbook.com"],
