<section class="section">
  <div class="container" style="max-width: 420px;">
    <h2 class="title is-4">Create your account</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <%= f.fields_for :profile, Profile.new do |pf| %>
        <div class="field">
          <%= pf.label :name, class: "label" %>
          <div class="control">
            <%= pf.text_field :name, class: "input", autocomplete: "name", placeholder: "Jane Smith" %>
          </div>
        </div>
      <% end %>

      <div class="field">
        <%= f.label :email, class: "label" %>
        <div class="control">
          <%= f.email_field :email, class: "input", autofocus: true, autocomplete: "email", placeholder: "jane@example.com" %>
        </div>
      </div>

      <hr>

      <div class="field">
        <%= f.label :password, class: "label" do %>
          Password
          <% if @minimum_password_length %>
            <span class="has-text-grey is-size-7">(<%= @minimum_password_length %> characters minimum)</span>
          <% end %>
        <% end %>
        <div class="control">
          <%= f.password_field :password, class: "input", autocomplete: "new-password", placeholder: "••••••••" %>
        </div>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, class: "label" %>
        <div class="control">
          <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password", placeholder: "••••••••" %>
        </div>
      </div>

      <div class="field" style="margin-top: 1.5rem;">
        <%= f.submit "Sign up", class: "button is-dark is-fullwidth" %>
      </div>
    <% end %>

    <%= render "users/shared/links" %>
  </div>
</section>

